<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
      Pleos App Market 심사: 승인되지 않은 권한을 선언하면 탈락하므로 실제로 쓰는 것만 선언한다.
      CAR_ENERGY: 연료 잔량·연비·EV 배터리 / CAR_DRIVE: 주행거리·트립 / CAR_SAFETY: 경고등
      android CAR_INFO (normal): 탱크 용량 INFO_FUEL_CAPACITY. Pleos SDK에 없어 AAOS 속성으로 읽는다.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 네이버 지도 인증 키는 NanugilApplication에서 코드로 설정한다 (매니페스트 meta-data 불필요). -->
    <application
        android:name=".NanugilApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nanugil">
        <uses-library
            android:name="android.car"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 그룹 드라이브 지도: 주행 중에도 띄울 수 있는 화면 (AAOS 주행 중 사용 제한 대상 아님) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 정산 입력: 글자 입력 화면이라 distractionOptimized를 붙이지 않는다. 주행 중에는 시스템이 가린다. -->
        <activity
            android:name=".ui.settlement.SettlementActivity"
            android:exported="false" />

        <!-- 송금 링크 등록: 글자 입력 화면이라 distractionOptimized를 붙이지 않는다. -->
        <activity
            android:name=".ui.settlement.PayLinkSetupActivity"
            android:exported="false" />
    </application>

</manifest>
