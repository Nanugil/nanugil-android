<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
      Pleos App Market 심사: 승인되지 않은 권한을 선언하면 탈락하므로 실제로 쓰는 것만 선언한다.
      CAR_ENERGY: 연료 잔량·연비·EV 배터리 / CAR_DRIVE: 주행거리·트립 / CAR_SAFETY: 경고등
    -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- NAVI_ROUTE: 목적지·경유지·위치 조회 / NAVI_ROUTE_SEARCH: 경로 요청·경유지 추가·재탐색 (내장 내비, ADR-001) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- NAVI_CUSTOM_MAP: 앱에서 내장 내비의 장소 검색·안내 화면을 연다 -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 내 차 위치는 내장 내비(NAVI_ROUTE, getCurrentLocationInfo)에서 받으므로 위치 권한은 쓰지 않는다 -->
    <!-- 목적지 음성 검색 (마이크). dangerous 권한이라 App Market 심사 때 사용 사유 필요 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 패키지 가시성: 내장 내비 앱을 실행하려면 선언해야 한다 -->
    <queries>
        <package android:name="ai.umos.maps.android.navigation.app" />
        <!-- 음성 인식 엔진(SpeechRecognizer)을 찾으려면 선언해야 한다 -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- 네이버 지도 인증 키는 NanugilApplication에서 코드로 설정한다 (매니페스트 meta-data 불필요). -->
    <application
        android:name=".NanugilApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nanugil">
        <!-- 그룹 지도·정산 화면. 주행 화면의 차량 버튼으로 들어온다 (런처 아이콘 없음). -->
        <activity
            android:name=".MainActivity"
            android:exported="false">
            <!-- 지도는 주행 중에도 보는 화면이라 주행 중 사용 제한(UX Restrictions)에서 뺀다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 앱 진입점(런처 아이콘은 이것 하나). TMAP식 주행 화면, 일반 Activity라 지도 끌기·확대·회전이 된다. -->
        <activity
            android:name=".ui.navi.NaviDriveActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 띄울 수 있는 화면 (AAOS 주행 중 사용 제한 대상 아님) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
